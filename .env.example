# Public host paths only. Generate credentials separately; never put values here.
ARBITER_SECRETS_DIR=D:/AI & ML/ArbiterData/secrets
ARBITER_DATA_LINUX_ROOT=/run/desktop/mnt/host/d/AI & ML/ArbiterData
ARBITER_API_PORT=8000
ARBITER_OIDC_ISSUER=https://localhost:18443/realms/arbiter
ARBITER_OIDC_AUDIENCE=arbiter-api
ARBITER_OIDC_JWKS_URL=https://arbiter-p0-keycloak:8443/realms/arbiter/protocol/openid-connect/certs
ARBITER_OIDC_CA_FILE=D:/AI & ML/ArbiterData/phase0/identity-ca.pem
ARBITER_IDENTITY_NETWORK=arbiter-p0-identity
ARBITER_KEYS_PEPPER_VERSION=1
